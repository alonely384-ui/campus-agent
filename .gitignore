# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# ---- 环境变量（绝对不要上传！里面有 API Key）----
.env
.env.local

# ---- 数据与向量库 ----
data/uploads/*
!data/uploads/.gitkeep
data/chroma*/
data/chroma_*/
data/papers/
data/eval/pages/
data/models/
*.sqlite3

# 引用图谱的生成物：可随时用 scripts/build_graph.py 重建，不进仓库
# （ref-titles-cache.json 是权威库查询缓存，体积随论文数增长，同样不入库）
data/meta/citation-graph*.json
data/meta/ref-titles-cache.json

# 重建解析结果前的临时备份，只在本地改动时用，不进仓库
data/meta/*.before.json
data/meta/*.pre-rebuild.json

# 1.6 写作助手的生成物，全部按内容哈希命名，随时可重新生成。
# 注意：.gitignore 不支持行尾注释，# 必须独占一行，否则整行会被当成字面路径。
data/meta/charts/
data/meta/diagrams/
data/meta/zh2en/
data/meta/_preview/
data/meta/figures/
data/meta/translations/

# ---- 工具缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 编辑器 ----
# .vscode 里只保留 settings.json（团队共用配置），其他忽略
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log
logs/

# ---- 赛题材料 / 本地临时文件（体积大，不进仓库）----
科研小助手*
第八届传智杯赛项*.docx
.pytest_tmp/

# ---- 鐜鍙橀噺澶囦唤 / 涓存椂鏂囦欢锛堥槻姝㈣鎻愪氦瀵嗛挜锛?---
.env.*
*.bak
*.orig
!.env.example
_public/
