# 把本文件复制成 .env，然后填入你自己的值
# .env 已经被 .gitignore 排除，不会被上传到 GitHub

# ---- LLM API ----
# 去 https://platform.deepseek.com 注册后创建 API Key
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 向量库 ----
CHROMA_DIR=./data/chroma

# ---- 数据库 ----
REDIS_URL=redis://localhost:6379/0
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/campus_agent

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
