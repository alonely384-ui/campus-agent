# 把本文件复制成 .env，然后填入你自己的值
# .env 已经被 .gitignore 排除，不会被上传到 GitHub
#
# 本文件列的是**全部可调项**，和设置中心（/ui/settings.html）一一对应。
# 不想手改文件就直接用设置页：改完会原子写回 .env 并热生效。
# 注意：系统环境变量优先于 .env。如果某一项被环境变量覆盖，
#       设置页会明确标出「生效值 X（来自系统环境变量）」。

# ---- LLM API ----
# 去 https://platform.deepseek.com 注册后创建 API Key
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 向量库 ----
CHROMA_DIR=./data/chroma

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# dev 开发 / prod 生产。生产模式下 /docs、/redoc、/openapi.json 自动关闭，
# 管理员 Cookie 也会加上 Secure 标记（因此生产必须走 HTTPS）。
APP_ENV=dev

# ---- 管理员认证（公网部署必须填，留空则管理功能整体不可用）----
# 设置中心、论文删除等 8 个管理接口需要口令登录。两者都**留空时默认拒绝**，
# 访问管理接口返回 503 而不是放行——不存在「忘了配就等于不设防」这种情况。
# ADMIN_TOKEN         管理员登录口令，自己定一个足够长的随机串
# ADMIN_COOKIE_SECRET 会话 Cookie 的签名密钥，和口令用不同的随机串
# 生成办法：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
ADMIN_COOKIE_SECRET=

# ---- 反向代理（可选）----
# 只有来自这里列出的地址的连接才信任 X-Forwarded-For，用逗号分隔。
# 反代在本机时填 127.0.0.1（默认已信任，不用写）。
# 直接暴露 8000 端口、前面没有代理时保持为空，这样伪造 XFF 头无效。
# TRUSTED_PROXIES 为空表示不信任任何转发头（推荐：直接暴露时）
TRUSTED_PROXIES=

# ---- 资源限额 ----
# 限流总开关，1 开 / 0 关。0 只建议在跑测试时用。
SECURITY_LIMIT_ENABLED=1
# 每日真实模型调用次数上限（不是 HTTP 请求数）。一次提问可能触发
# 查询翻译 + 主循环多轮 + 修复回环，这些都会计数。跨天自动清零，落盘持久化。
LLM_DAILY_BUDGET=800
# 同时进行的上游模型请求并发数上限
LLM_MAX_CONCURRENCY=4
# 单次模型调用的输出 token 上限
LLM_MAX_TOKENS=2048
# 每日预算计数文件位置（相对项目根目录）
BUDGET_FILE=data/meta/llm-budget.json

# ---- RAG 检索参数（设置中心「论文检索参数」板块） ----
# 三路召回的融合权重，0 表示完全不使用该通道
RAG_W_DENSE=2.0            # 稠密（ONNX 句向量）通道权重
RAG_W_BM25=1.0             # 关键词（BM25）通道权重
RAG_W_HASH=0.5             # 哈希向量通道权重
RAG_RRF_K=60               # RRF 融合的平滑常数，越大越平滑
RAG_RERANK=1               # 交叉编码器重排序：1 开 / 0 关
RAG_RERANK_POOL=15         # 重排候选池大小，进来重排的条数
RAG_RECALL_DEPTH=50        # 每路召回的深度
RAG_CITATION_PENALTY=0.6   # 参考文献区域的降权系数，压掉纯引用噪声

# ---- 定时刷新（设置中心「定时推荐」板块） ----
DISCOVER_SCHEDULE=daily    # daily 每天 / weekly 每周一 / off 关闭
DISCOVER_HOUR=8            # 几点跑，0-23（服务器本地时区）

# ---- 可选：路径覆盖（一般不用改） ----
# 不给就按项目根目录算；RAG_OCR_DIR 与 RAG_RERANK_DIR 支持绝对路径
# RAG_OCR_DIR=data/papers/ocr
# RAG_RERANK_DIR=data/models/ms-marco-MiniLM-L6-v2
# RAG_OCR_DPI=200

# ---- 可选：开发模式 ----
# 1 开启 uvicorn 热重载（改代码自动重启）。生产不要开，会多起一个 file watcher
# APP_RELOAD=0

# ---- 已废弃（不要再填，填了也不生效） ----
#   REDIS_URL    代码从未使用，数据全部存 JSON
#   MYSQL_URL    代码从未使用，无 ORM、无数据库连接